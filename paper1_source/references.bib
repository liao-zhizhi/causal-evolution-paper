             {Interaction} with feedback modifiers},
  journal = {Biochemistry},
  volume  = {7},
  number  = {11},
  pages   = {4030--4034},
  year    = {1968},
  doi     = {10.1021/bi00851a033}
}

@article{vanderpol1926,
