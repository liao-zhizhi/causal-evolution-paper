  volume  = {2},
  number  = {11},
  pages   = {978--992},
  year    = {1926},
  doi     = {10.1080/14786442608564127}
}

@article{johnson2011michaelis,
  author  = {Johnson, Kenneth A. and Goody, Roger S.},
  title   = {The original {Michaelis} constant: Translation of the 1913
